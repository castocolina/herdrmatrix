{
  "id": "root",
  "type": "row",
  "theme": "phosphor-rain",
  "colors": { "accent": "#00ff41", "border": "#0d3b1c" },
  "font": "JetBrains Mono",
  "font_size": 14,
  "ui_font": "JetBrains Mono",
  "terminal_padding": [10, 8],
  "terminal_opacity": 0.82,
  "preview": "layouts/phosphor-rain.svg",
  "background": { "image": "mods/phosphor-rain/backgrounds/phosphor-rain.jpg", "fit": "cover" },
  "divider": { "width": 1, "color": "border" },
  "children": [
    {
      "id": "sidebar", "type": "column", "size": { "px": 240 }, "min": 40, "max": 480,
      "background": "#010702e0",
      "divider": { "width": 1, "color": "border" },
      "children": [
        { "id": "spaces", "type": "block", "content": { "mod": "spaces" } },
        { "id": "agents", "type": "block", "content": { "mod": "agents" } },
        { "id": "rain", "type": "block", "size": { "px": 150 }, "min": 0, "max": 400,
          "content": { "mod": "phosphor-rain" } },
        { "id": "sidebar-footer", "type": "block", "size": { "px": 69 },
          "content": { "mod": "workspace-chrome", "props": { "footer": true } } }
      ]
    },
    {
      "id": "work", "type": "column",
      "children": [
        { "id": "tabs", "type": "block", "size": { "px": 30 }, "background": "#010702cc",
          "content": { "mod": "phosphor-tabs" } },
        {
          "id": "body", "type": "row", "divider": { "width": 1, "color": "border" },
          "children": [
            {
              "id": "main", "type": "block", "padding": 8,
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8, "radius": 6, "background": "#020a04b3",
                  "border": { "width": 1, "color": "border" },
                  "focus": { "width": 1, "color": "accent" },
                  "lone": true
                }
              }
            },
            {
              "id": "panel", "type": "column", "hidden": true,
              "size": { "px": 320 }, "min": 200, "max": 640,
              "background": "#010702e0",
              "children": [
                { "id": "panel-body", "type": "stack", "active": "files",
                  "children": [
                    { "id": "files", "type": "block", "content": { "mod": "files" } },
                    { "id": "changes", "type": "block", "content": { "mod": "changes" } }
                  ] }
              ]
            }
          ]
        }
      ]
    }
  ]
}
